#include <stdio.h>
#include <graphics.h>
#include <conio.h>
int main()
{
    int x1, y1, x2, y2, dx, dy, p, x, y, gd = DETECT, gm;
    printf("Enter x1 y1 x2 y2: ");
    scanf("%d%d%d%d", &x1, &y1, &x2, &y2);
    initgraph(&gd, &gm, "C:\\TURBOC3\\BGI");
    for(dx = x2-x1, dy = y2-y1, p = 2*dy-dx, x = x1, y = y1; x <= x2; x++)
{
        putpixel(x, y, WHITE);
        p >= 0 ? (y++, p += 2*(dy - dx)) : (p += 2*dy);
    }
    getch();
    closegraph();
    return 0;
}
