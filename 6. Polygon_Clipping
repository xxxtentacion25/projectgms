#include <stdio.h>
#include <graphics.h>
#include <conio.h>
int main()
{
    int gd=DETECT, gm;
    int n, i;
    int p[20];
    int w[] = {220,140, 420,140, 420,340, 220,340, 220,140};
    initgraph(&gd, &gm, "C:\\TURBOC3\\BGI");
    etcolor(RED);
    drawpoly(5, w);
    printf("Enter number of vertices: ");
    scanf("%d", &n);
    printf("Enter x and y coordinates:\n");
    for(i=0; i<n; i++)
    {
        printf("Enter x%d y%d: ", i+1, i+1);
        scanf("%d%d", &p[2*i], &p[2*i+1]);
    }
    p[2*n] = p[0];
    p[2*n+1] = p[1];
    setcolor(WHITE);
    drawpoly(n+1, p);
    getch();
    setcolor(RED);
    drawpoly(5, w);
    setfillstyle(SOLID_FILL, BLACK);
    floodfill(2,2,RED);
    printf("Clipped Polygon");
    getch();
    closegraph();
    return 0;
}
