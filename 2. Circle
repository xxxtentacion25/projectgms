#include <stdio.h>
#include <graphics.h>
#include <conio.h>
int main()
{
    int xc, yc, r, x = 0, y, p, gd = DETECT, gm;
    printf("Enter xc yc r: ");
    scanf("%d%d%d", &xc, &yc, &r);
    initgraph(&gd, &gm, "C:\\TURBOC3\\BGI");
    y = r;
    p = 1 - r;
    while (x <= y)
{
        putpixel(xc+x, yc+y, WHITE); putpixel(xc-x, yc+y, WHITE);
        putpixel(xc+x, yc-y, WHITE); putpixel(xc-x, yc-y, WHITE);
        putpixel(xc+y, yc+x, WHITE); putpixel(xc-y, yc+x, WHITE);
        putpixel(xc+y, yc-x, WHITE); putpixel(xc-y, yc-x, WHITE);
        x++;
        p += (p < 0) ? (2 * x + 1) : (2 * (x - --y) + 1);
    }
    getch();
    closegraph();
    return 0;
}
